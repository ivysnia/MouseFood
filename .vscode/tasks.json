{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run",
      "command": "dotnet",
      "args": ["run", "--project", "src/MouseFood.csproj"],
      "type": "process",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build",
      "command": "dotnet",
      "args": ["build", "-c", "Release"],
      "type": "process",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "command": "dotnet",
      "args": ["test"],
      "type": "process",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish",
      "command": "dotnet",
      "args": [
        "publish", "src/MouseFood.csproj",
        "-c", "Release",
        "-r", "win-x64",
        "--self-contained",
        "-p:PublishSingleFile=true",
        "-p:IncludeNativeLibrariesForSelfExtract=true",
        "-o", "Dist"
      ],
      "type": "process",
      "problemMatcher": "$msCompile"
    }
  ]
}
